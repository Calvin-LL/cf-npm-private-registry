---
interface Props {
  ecosystem: "npm" | "cargo";
  class?: string;
}

const { ecosystem, class: className = "h-5 w-5 shrink-0" } = Astro.props;
const cargoLogo =
  "data:image/png;base64,";
---

{
  ecosystem === "npm" ? (
    <svg class={className} viewBox="0 0 24 24" role="img" aria-label="npm">
      <rect width="24" height="24" rx="2" fill="#CB3837" />
      <path
        fill="#fff"
        d="M4 5.5h16v13h-8v-9H9.5v9H4v-13Zm2.5 2.5v8h1v-8h7v8h3V8h-11Z"
      />
    </svg>
  ) : (
    <img class={className} src={cargoLogo} alt="Cargo" width="64" height="57" />
  )
}
